<?xml version="1.0" encoding="utf-8"?>
<GameData>

    <!-- ==================== TRAIT ==================== -->
    <Traits>
        <Row>
            <Type>TRAIT_NETWORK_EFFECTS</Type>
            <Description>TXT_KEY_TRAIT_NETWORK_EFFECTS</Description>
            <ShortDescription>TXT_KEY_TRAIT_NETWORK_EFFECTS_SHORT</ShortDescription>
            <!-- Free Startup Founder on discovering Currency (Babylon-style grant).
                 UNITCLASS_MERCHANT is the Great Merchant's class; the civ's
                 UnitClassOverride resolves it to UNIT_NETWORK_MERCHANT. -->
            <FreeUnit>UNITCLASS_MERCHANT</FreeUnit>
            <FreeUnitPrereqTech>TECH_CURRENCY</FreeUnitPrereqTech>
        </Row>
    </Traits>

    <!-- Hidden branchless policy carrying the Scholasticism flag (allied
         City-States provide a Science bonus equal to 25% of their own
         output, via MINOR_CIV_SCIENCE_BONUS_MULTIPLIER). Granted free and
         automatically to Network State players by NetworkState.lua; it
         never appears in the policy picker because it has no branch.
         This makes the science half of the UA engine-native: it shows in
         the science tooltip and research turn estimates correctly. -->
    <Policies>
        <Row>
            <Type>POLICY_NETWORK_STATE_SCIENCE</Type>
            <Description>TXT_KEY_TRAIT_NETWORK_EFFECTS_SHORT</Description>
            <MinorScienceAllies>true</MinorScienceAllies>
        </Row>
    </Policies>

</GameData>
